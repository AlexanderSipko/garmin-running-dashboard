# SQLite по умолчанию. Для PostgreSQL укажи строку подключения.
DATABASE_URL=
# Ключ Fernet для шифрования ключей пользователей.
SECRETS_ENCRYPTION_KEY=
# Публичный HTTPS адрес приложения. Локально оставь пустым.
APP_ORIGIN=

# Серверные настройки GigaChat.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca_pem.crt
