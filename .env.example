# Локально: скопируй этот шаблон в .env в корне проекта.
# Пустой DATABASE_URL включает SQLite (backend/data/dashboard.sqlite3 в Docker).
# Docker задаёт SQLITE_PATH=/app/data/dashboard.sqlite3 в compose.
# Для собственного PostgreSQL укажи postgresql://USER:PASSWORD@HOST:5432/DB.
DATABASE_URL=

# Сгенерируй ключ Fernet по инструкции в README. Сохрани его между запусками.
SECRETS_ENCRYPTION_KEY=

# Локально оставь пустым. В Vercel backend укажи HTTPS-адрес сайта без /.
APP_ORIGIN=

# Необязательно: серверные настройки GigaChat. Локальный путь ниже для Docker.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE=
# GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca_pem.crt

# Локальные порты задаются в docker-compose.yml: сайт 127.0.0.1:8080,
# API внутри Docker на 8000. В Vercel задавать PORT не нужно.
#
# Vercel backend (garmin-running-dashboard-api):
# DATABASE_URL — только если задаёшь строку подключения вручную.
# Иначе Neon добавляет переменные с префиксом GARMIN_ при подключении базы.
# Порядок выбора: DATABASE_URL → GARMIN_DATABASE_URL → GARMIN_POSTGRES_URL
# → GARMIN_DATABASE_URL_UNPOOLED. Остальные переменные Neon приложение не читает.
# Строка подключения уже содержит логин и пароль роли PostgreSQL, имя базы,
# адрес, порт и параметры TLS. Отдельные PGUSER, PGPASSWORD и PORT не нужны.
# SECRETS_ENCRYPTION_KEY — отдельный облачный ключ Fernet.
# APP_ORIGIN=https://garmin-running-dashboard-sandy.vercel.app
#
# Vercel frontend (garmin-running-dashboard):
# BACKEND_ORIGIN=https://garmin-running-dashboard-api.vercel.app
# VITE_PUBLIC_DEMO=false
#
# Аккаунты приложения создаются при регистрации. Ключи Garmin и GigaChat
# пользователь вводит в личном кабинете. Настройки сохраняются в выбранной БД.
# SQLite и облачная PostgreSQL хранят данные независимо.
