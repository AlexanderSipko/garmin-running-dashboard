{
  "framework": "vite",
  "buildCommand": "VITE_PUBLIC_DEMO=${VITE_PUBLIC_DEMO:-true} npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/backend?path=:path*" },
    { "source": "/workouts", "destination": "/index.html" },
    { "source": "/connect", "destination": "/index.html" },
    { "source": "/calendar/:day", "destination": "/index.html" }
  ]
}
