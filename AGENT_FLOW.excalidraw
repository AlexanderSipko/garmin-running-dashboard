      "versionNonce": 3052,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Контракт класса сценариев",
      "originalText": "Контракт класса сценариев",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
