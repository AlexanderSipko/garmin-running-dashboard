    {
      "id": "audit-agent-44",
      "type": "text",
      "x": 18,
      "y": 8665,
      "width": 494,
      "height": 198.9,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
